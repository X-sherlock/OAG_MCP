- skill_id: get_fund_metric_values
  skill_name: 获取基金指标值
  description: 按基金代码、周期和指标列表获取基金本体指标事实。
  target_object_type: Fund
  input_params:
  - fund_code
  - period
  - attributes
  output_attributes:
  - return_rate
  - annualized_return
  - max_drawdown
  - volatility
  - standard_deviation
  - sharpe_ratio
  - sortino_ratio
  - calmar_ratio
  - var
  - cvar
  - downside_risk
  provides_fact_types:
  - metric_value
  supported_subject_types:
  - Fund
  supported_attributes:
  - return_rate
  - annualized_return
  - max_drawdown
  - volatility
  - standard_deviation
  - sharpe_ratio
  - sortino_ratio
  - calmar_ratio
  - var
  - cvar
  - downside_risk
  supported_constraints:
  - period
  output_fact_schema:
  - fact_requirement_id
  - object_type
  - instance_ref
  - attribute_name
  - period
  - value
  - unit
  - as_of_date
  - source
  related_queries:
  - fund_perf_interval_query
  - fund_risk_interval_query
  permission_scope: fund_public_data:read
  enabled: true
